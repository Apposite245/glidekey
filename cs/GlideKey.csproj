<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GlideKey</AssemblyName>
    <RootNamespace>GlideKey</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Win32 icon resource: what Explorer, the taskbar and a pinned shortcut show. -->
    <ApplicationIcon>assets\glidekey.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\words.txt" />
    <!-- the same icon again, for the window and tray at runtime -->
    <EmbeddedResource Include="assets\glidekey.ico" />
  </ItemGroup>

</Project>
